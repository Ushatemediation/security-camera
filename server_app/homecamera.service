[Unit]
Description=HomeCamera Server — приём клипов и веб-галерея
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homecamera
Group=homecamera
EnvironmentFile=/etc/homecamera.env
WorkingDirectory=/opt/homecamera
ExecStart=/opt/homecamera/venv/bin/gunicorn -w 2 --threads 4 -b 0.0.0.0:8080 \
    --timeout 300 --certfile /etc/homecamera/cert.pem --keyfile /etc/homecamera/key.pem \
    app:app
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/var/lib/homecamera

[Install]
WantedBy=multi-user.target
